# Supabase の接続情報 (Supabase ダッシュボード → Project Settings → API)
# このファイルを .env.local にコピーして値を入れる (.env.local は git に入らない)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=ここに anon (public / publishable) キー

# 注意: service_role (secret) キーは、ここにもリポジトリにも絶対に入れない。
#       アプリに入れてよいのは anon キーだけ。データの保護は RLS (supabase/migrations) が担う。
